rules_version = '2';

// FROZEN 2026-10-11: Inspectra migrated to Supabase (fwtgdgeiffnvqyrobixc).
// Deny everything. Pre-freeze rules: firestore.rules.pre-freeze.bak.
// Project scheduled for deletion ~30 days after the freeze.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
