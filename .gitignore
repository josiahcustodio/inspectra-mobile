# Critical: Secret files - NEVER commit these
serviceAccountKey.json
bin/admin_actions.log
*.pem
*.p8
*.p12
*.keystore
google-services.json
GoogleService-Info.plist

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# Android
android/local.properties
android/.gradle/
android/key.properties
android/app/google-services.json

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Runner/GoogleService-Info.plist

# Environment / config
# Nothing reads a .env file: flutter_dotenv is not a dependency and Firebase
# config lives in lib/core/config/firebase_options.dart. Ignored anyway so a
# stray local one can never be committed.
.env
.env.*

# Temporary / OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/

# Device debug dumps and captured tool output
crash_log.txt
device_full.log
logcat*.txt
analyze*.json
analyze*.txt
out.json
error.txt

# Unrelated local tooling
.agent/

# Firestore rules tests (Node tooling, isolated from the Flutter app)
firestore-tests/node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Web dashboard lives in its own repo (inspectra-web)
web-dashboard/
bin/__pycache__/
hs_err_pid*.log
